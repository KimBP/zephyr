config DISPLAY_ESP32_LCD_CAM_RGB
	bool "ESP32 LCD_CAM RGB scanout backend"
	default y
	select DISPLAY_RGB_SCANOUT
	depends on SOC_SERIES_ESP32S3
	depends on DT_HAS_ESPRESSIF_ESP32_LCD_CAM_RGB_ENABLED
	help
	  Enable RGB scanout backend for ESP32-S3 LCD_CAM.
	  This backend is used by RGB panel drivers through the generic
	  display RGB scanout interface.

config DISPLAY_ESP32_LCD_CAM_RGB_BOUNCE_BUFFER_SIZE
	int "LCD_CAM RGB bounce buffer size per instance (bytes)"
	depends on DISPLAY_ESP32_LCD_CAM_RGB
	range 1024 65536
	default 16128
	help
	  Maximum internal SRAM reserved for the bounce buffers of each
	  LCD_CAM RGB scanout instance. The driver selects a layout within this
	  limit based on the framebuffer size. Each DMA chunk must be 256 to
	  4032 bytes and a multiple of 64 bytes. The DMA ring contains at least
	  four bounce buffers, each holding one chunk. The framebuffer must divide
	  evenly into chunks, with a whole number of frame chunks per ring cycle.

