config ST7701_RGB
	bool "Waveshare ST7701 RGB panel (skeleton)"
	default y
	depends on DISPLAY
	depends on DT_HAS_SITRONIX_ST7701_RGB_ENABLED
	select MIPI_DBI
	help
	  Enable skeleton driver for ST7701 in RGB panel use-cases where
	  initialization commands are sent over a MIPI-DBI command channel.

config ST7701_RGB_INIT_PRIORITY
	int "ST7701 RGB init priority"
	default 85
	depends on ST7701_RGB
	help
	  Initialization priority for the ST7701 RGB panel skeleton driver.

